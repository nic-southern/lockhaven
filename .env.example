APP_ENV=development
PRODUCT_NAME=Lockhaven
APP_BASE_URL=https://app.example.com
DATABASE_URL=postgresql://postgres:replace_me@127.0.0.1:5432/nms_vpn
POSTGRES_PASSWORD=replace_me # openssl rand -hex 16
REDIS_URL=redis://127.0.0.1:6379/0
VPN_PUBLIC_HOSTNAME=vpn.example.com
VPN_PUBLIC_PORT=51820
VPN_CIDR=10.80.0.0/16
VPN_SERVER_IP=10.80.0.1
VPN_SERVER_PUBLIC_KEY=replace_me # generated by scripts/deploy-production.sh for production
VPN_DEFAULT_ALLOWED_IPS=10.80.0.1/32
WIREGUARD_INTERFACE=wg0
VPNCTL_PATH=/usr/local/sbin/vpnctl
FLOW_LOG_PATH=/var/log/lockhaven/flows.jsonl # ulogd2 output tailed by the worker
FLOW_RETENTION_DAYS=30
FLOW_ROLLUP_RETENTION_DAYS=365
REMOTE_ACCESS_PROVIDER=guacamole
GUACAMOLE_BASE_URL=http://127.0.0.1:8080/guacamole/
GUACAMOLE_DATABASE_URL=postgresql://guacamole:replace_me@guacamole-db:5432/guacamole_db
GUACAMOLE_DB_PASSWORD=replace_me # openssl rand -hex 16
GUACAMOLE_API_SESSION_TIMEOUT=1440
ROOT_DOMAIN=example.com
APP_HOSTNAME=app.example.com
GUAC_HOSTNAME=guac.example.com
REMOTE_CREDENTIALS_KEY=replace_me # openssl rand -hex 32
BETTER_AUTH_SECRET=replace_me # openssl rand -hex 32
BETTER_AUTH_URL=https://app.example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_me # openssl rand -hex 16, or leave unset and let the deploy script generate one
ADMIN_NAME=Admin
ADMIN_ROLE=owner
MAIL_FROM="Lockhaven <noreply@example.com>"
# Prefer RESEND_API_KEY. SMTP_URL is used only when Resend is unset.
RESEND_API_KEY=
SMTP_URL=
# Backups: set BACKUP_PASSPHRASE in /opt/lockhaven/backup.env (mode 600), not here.
# Optional GUACAMOLE_API_URL for server-side session control on the private network.
SESSION_RECORDING_ROOT=/var/lib/guacamole/recordings # pragma: allowlist secret
SESSION_RECORDING_RETENTION_DAYS=30
ACCESS_REQUEST_TTL_HOURS=8
SSO_OIDC_ISSUER=https://auth.newmarketsecurity.com/realms/nms
SSO_OIDC_DISCOVERY_URL=https://auth.newmarketsecurity.com/realms/nms/.well-known/openid-configuration
SSO_OIDC_CLIENT_ID=lockhaven
SSO_OIDC_CLIENT_SECRET=replace_me
SSO_OIDC_PROVIDER_ID=lockhaven
SSO_ALLOWED_DOMAINS=example.com
SSO_CLAIMS_MAP={"claim":"groups","values":{"operators":{"organizationRole":"operator"},"technicians":{"organizationRole":"technician"}}}
SSO_DEFAULT_ORGANIZATION_ID=
SSO_REQUIRED=false
SSO_TRUST_IDP_MFA=false
SSO_SAML_PROVIDER_ID=sso-saml
SSO_SAML_ENTRY_POINT=
SSO_SAML_CERT=
SSO_SAML_AUDIENCE=
SSO_SAML_METADATA_XML=

# Tickets ingest (signed webhook). Host only; do not commit secrets.
# TICKETING_INGEST_URL=https://pm.example.com/ingest/lockhaven
# TICKETING_INGEST_SECRET=replace_me

